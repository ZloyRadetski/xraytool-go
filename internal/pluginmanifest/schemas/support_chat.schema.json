{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "master_key": {"type": "string", "minLength": 1},
    "master_key_file": {"type": "string", "minLength": 1},
    "legacy_master_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "key_version": {"type": "integer", "minimum": 1, "maximum": 65535},
    "migrate_legacy_data": {"type": "boolean"},
    "retention_days": {"type": "integer", "minimum": 1},
    "max_open_per_user": {"type": "integer", "minimum": 1},
    "websocket_enabled": {"type": "boolean"},
    "ws_ping_interval": {"type": "string", "minLength": 1},
    "ws_pong_timeout": {"type": "string", "minLength": 1},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {"type": "string", "enum": ["sqlite", "postgres"]},
        "sqlite_path": {"type": "string", "minLength": 1},
        "dsn": {"type": "string", "minLength": 1}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage_path": {"type": "string", "minLength": 1},
        "max_file_size_mb": {"type": "integer", "minimum": 1}
      }
    }
  },
  "anyOf": [
    {"required": ["master_key"]},
    {"required": ["master_key_file"]}
  ]
}
